{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node generate-sitemap.mjs && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:contact": "tsx --test api/contact.test.ts",
    "test:contact:live": "tsx --test api/contact.live.test.ts",
    "format": "prettier --write .",
    "generate-sitemap": "node generate-sitemap.mjs",
    "generate-favicons": "node generate-favicons.js",
    "generate-og-image": "node generate-og-image.js",
    "generate-assets": "npm run generate-favicons && npm run generate-og-image",
    "generate-qr": "node generate-qr.js"
  },
  "dependencies": {
    "@animateicons/react": "^0.4.3",
    "@heroicons/react": "^2.2.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.9.3",
    "resend": "^6.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.12"
  }
}
